{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted persistent online trace v4 with authoritative turn-history append",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runner_protocol",
    "runner_session_id",
    "stream_id",
    "query_id",
    "step_index",
    "initial_pool_sha256",
    "input_sha256",
    "system_output_sha256",
    "runner_chain_before_sha256",
    "runner_chain_after_sha256",
    "runner_record_sha256",
    "runner_receipt_hmac_sha256",
    "response_text",
    "selected_memory_ids",
    "supporting_event_ids",
    "predicted_action_keys",
    "predicted_operation_state_labels",
    "memory_write_delta",
    "recognized_active_config",
    "effective_behavior",
    "system_state_before_sha256",
    "system_state_after_sha256",
    "runner_measured_latency_ms",
    "history_append_sha256"
  ],
  "properties": {
    "runner_protocol": {
      "const": "trusted_online_runner_v4_history_append"
    },
    "runner_session_id": {
      "type": "string",
      "minLength": 32
    },
    "stream_id": {
      "type": "string",
      "minLength": 1
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "step_index": {
      "type": "integer",
      "minimum": 1
    },
    "initial_pool_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "system_output_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runner_chain_before_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runner_chain_after_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runner_record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runner_receipt_hmac_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "response_text": {
      "type": "string"
    },
    "selected_memory_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supporting_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "predicted_action_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "predicted_operation_state_labels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "episode_id",
          "state"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "episode_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "memory_write_delta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "writes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "deletes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "recognized_active_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_id",
        "behavior"
      ],
      "properties": {
        "config_id": {
          "type": "string"
        },
        "behavior": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "effective_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "behavior",
        "source",
        "overridden_dimensions"
      ],
      "properties": {
        "behavior": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "overridden_dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "system_state_before_sha256": {
      "type": "string"
    },
    "system_state_after_sha256": {
      "type": "string"
    },
    "runner_measured_latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "history_append_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}