{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stream_id",
    "user_id",
    "dataset_partition",
    "memory_pool_id",
    "steps"
  ],
  "properties": {
    "stream_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "dataset_partition": {
      "enum": [
        "train",
        "dev",
        "test"
      ]
    },
    "memory_pool_id": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query_id",
          "step_index",
          "query_time",
          "new_raw_events",
          "current_query"
        ],
        "properties": {
          "query_id": {
            "type": "string"
          },
          "step_index": {
            "type": "integer",
            "minimum": 1
          },
          "query_time": {
            "type": "string"
          },
          "new_raw_events": {
            "type": "array"
          },
          "current_query": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "speaker",
              "text"
            ],
            "properties": {
              "event_id": {
                "type": "string"
              },
              "speaker": {
                "const": "user"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}